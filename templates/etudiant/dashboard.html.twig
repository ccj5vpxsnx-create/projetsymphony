{% extends 'base.html.twig' %}

{% block title %}Dashboard Etudiant{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2>Bienvenue, {{ etudiant.prenom }} {{ etudiant.nom }}</h2>
    <hr>
    <h4>Mes Soutenances</h4>

    {% if soutenances is empty %}
        <div class="alert alert-info">Aucune soutenance planifiée pour le moment.</div>
    {% else %}
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Enseignant</th>
                    <th>État</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                {% for soutenance in soutenances %}
                <tr>
                    <td>{{ soutenance.dateSoutenance|date('d/m/Y') }}</td>
                    <td>{{ soutenance.enseignant }}</td>
                    <td>
                        {% if soutenance.etat == 'a_venir' %}
                            <span class="badge bg-info">À venir</span>
                        {% elseif soutenance.etat == 'passee' %}
                            <span class="badge bg-warning">Passée</span>
                        {% elseif soutenance.etat == 'notee' %}
                            <span class="badge bg-success">Notée</span>
                        {% else %}
                            <span class="badge bg-secondary">-</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if soutenance.etat == 'notee' %}
                            <span class="badge bg-success fs-6">{{ soutenance.note }}/20</span>
                        {% else %}
                            <span class="badge bg-warning">En attente</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}