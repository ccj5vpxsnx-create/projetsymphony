{% extends 'base.html.twig' %}

{% block title %}Étudiants — Gestion Stages{% endblock %}

{% block body %}

{# ── Breadcrumb ── #}
<ul class="breadcrumb">
    <li><a href="#"><i class="fas fa-home"></i></a></li>
    <li><span class="sep">/</span></li>
    <li>Étudiants</li>
</ul>

{# ── Page header ── #}
<div class="page-header">
    <h1>
        <span>liste des</span>
        Étudiants
    </h1>
   
</div>

{# ── Table card ── #}
<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th><i class="fas fa-id-card" style="margin-right:.4rem;opacity:.5"></i>NCE</th>
                <th><i class="fas fa-user" style="margin-right:.4rem;opacity:.5"></i>Nom</th>
                <th>Prénom</th>
                <th style="text-align:right">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for etudiant in etudiants %}
            <tr>
                <td class="id-cell">{{ etudiant.id }}</td>
                <td>
                    <span class="badge-chip">
                        <i class="fas fa-hashtag" style="font-size:.65rem"></i>
                        {{ etudiant.nce }}
                    </span>
                </td>
                <td style="font-weight:600">{{ etudiant.nom }}</td>
                <td style="color:var(--muted)">{{ etudiant.prenom }}</td>
                <td>
                    <div class="action-group" style="justify-content:flex-end">
                        <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}" class="action-link view">
                            <i class="fas fa-eye"></i> Voir
                        </a>
                        <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="action-link edit">
                            <i class="fas fa-pen"></i> Modifier
                        </a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr class="empty-row">
                <td colspan="5">
                    <i class="fas fa-inbox" style="font-size:1.5rem;display:block;margin-bottom:.5rem;opacity:.3"></i>
                    Aucun étudiant enregistré.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
