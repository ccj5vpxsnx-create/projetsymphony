{% extends 'base.html.twig' %}

{% block title %}Étudiants — Gestion Stages{% endblock %}

{% block breadcrumb %}
    <li><span class="sep">/</span></li>
    <li>Étudiants</li>
{% endblock %}

{% block topbar_actions %}
    <a href="{{ path('app_etudiant_new') }}" class="btn btn-primary btn-sm">
        <i class="fas fa-plus"></i> Nouvel étudiant
    </a>
{% endblock %}

{% block body %}

<div class="page-header">
    <div class="page-title">
        <em>liste des</em>
        Étudiants
    </div>
</div>

{# ── Stats ── #}
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-label">Total étudiants</div>
        <div class="stat-value">{{ etudiants|length }}</div>
    </div>
    <div class="stat-card" style="border-top-color:#86efac">
        <div class="stat-label">Inscrits ce mois</div>
        <div class="stat-value">—</div>
    </div>
    <div class="stat-card" style="border-top-color:#fde68a">
        <div class="stat-label">Avec soutenance</div>
        <div class="stat-value">—</div>
    </div>
</div>

{# ── Table ── #}
<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th><i class="fas fa-id-card" style="margin-right:.35rem;opacity:.5"></i>NCE</th>
                <th><i class="fas fa-user" style="margin-right:.35rem;opacity:.5"></i>Nom</th>
                <th>Prénom</th>
                <th style="text-align:right">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for etudiant in etudiants %}
            <tr>
                <td class="id-cell">{{ etudiant.id }}</td>
                <td>
                    <span class="badge-chip">
                        <i class="fas fa-hashtag" style="font-size:.6rem"></i>
                        {{ etudiant.nce }}
                    </span>
                </td>
                <td style="font-weight:600">{{ etudiant.nom }}</td>
                <td style="color:var(--muted)">{{ etudiant.prenom }}</td>
                <td>
                    <div class="action-group" style="justify-content:flex-end">
                        <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}" class="action-link view">
                            <i class="fas fa-eye"></i> Voir
                        </a>
                        <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="action-link edit">
                            <i class="fas fa-pen"></i> Modifier
                        </a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr class="empty-row">
                <td colspan="5">
                    <i class="fas fa-inbox"></i>
                    Aucun étudiant enregistré.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
